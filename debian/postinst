#!/bin/sh
set -e

# Enable the live-whisper GNOME Shell extension system-wide.
# This creates a settings override for GNOME Shell so the extension
# is automatically enabled for all users (both existing and new).
case "$1" in
    configure)
        # Tell GNOME Shell to reload extension settings
        if which glib-compile-schemas >/dev/null 2>&1; then
            glib-compile-schemas /usr/share/glib-2.0/schemas/ 2>/dev/null || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac

# Attempt to enable the extension for the current user via D-Bus.
# This is best-effort — the extension will be loaded on next login
# (or immediately if GNOME Shell is running).
if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    if which gdbus >/dev/null 2>&1; then
        gdbus call --session \
            --dest org.gnome.Shell \
            --object-path /org/gnome/Shell \
            --method org.gnome.Shell.Extensions.EnableExtension \
            "live-whisper@local" 2>/dev/null || true
    fi
fi

exit 0
