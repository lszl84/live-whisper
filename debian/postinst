#!/bin/sh
set -e

case "$1" in
    configure)
        # Compile glib schemas so the extension-enable override takes effect
        if which glib-compile-schemas >/dev/null 2>&1; then
            glib-compile-schemas /usr/share/glib-2.0/schemas/ 2>/dev/null || true
        fi
        # Best-effort attempt to enable the extension for the current session
        if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
            gdbus call --session \
                --dest org.gnome.Shell \
                --object-path /org/gnome/Shell \
                --method org.gnome.Shell.Extensions.EnableExtension \
                "live-whisper@local" 2>/dev/null || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac

exit 0
